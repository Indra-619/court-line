# Google OAuth credentials (required for authentication)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT secret for token signing (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Access-token lifetime in minutes (default 30, clamped 5..1440).
# Sessions stay alive via the rotating refresh token; keep this short.
JWT_TTL_MINUTES=30

# Set true when serving over HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false

# Frontend URL for OAuth redirect
FRONTEND_URL=http://localhost:3000
